{
  "name": "@seggy116/next-diff",
  "version": "0.3.0",
  "description": "Compare your local Next.js site against live without leaving the page. Press a button, get a diff.",
  "keywords": [
    "nextjs",
    "next",
    "diff",
    "visual-diff",
    "visual-regression",
    "dev-tools",
    "devtools",
    "compare",
    "staging",
    "production",
    "responsive",
    "screenshot"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Seggys116/next-diff.git",
    "directory": "packages/next"
  },
  "homepage": "https://github.com/Seggys116/next-diff#readme",
  "bugs": "https://github.com/Seggys116/next-diff/issues",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./instrument": "./dist/instrument.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node build.mjs --clean",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-strip-types --test src/lib/url.test.ts",
    "dev": "node build.mjs"
  },
  "peerDependencies": {
    "next": "*",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.59.0",
    "motion": "^14.4.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "^4",
    "typescript": "^7"
  }
}
